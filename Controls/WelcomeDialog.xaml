<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="WindowsJournal.Controls.WelcomeDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WindowsJournal.Controls"
    Style="{StaticResource DefaultContentDialogStyle}">

    <ContentDialog.Resources>
        <ResourceDictionary>
            <!-- Hero backdrop behind each illustration: Windows 11 "Bloom", light or dark to match the theme.
                 Bloom is Microsoft's artwork (see THIRD-PARTY-NOTICES.md). To use the project's own art instead,
                 point these at welcome-light.jpg and welcome-dark.jpg. -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <ImageBrush x:Key="HeroBackgroundBrush"
                                AlignmentY="Center"
                                ImageSource="ms-appx:///Assets/Welcome/bloom-light.jpg"
                                Stretch="UniformToFill" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <ImageBrush x:Key="HeroBackgroundBrush"
                                AlignmentY="Center"
                                ImageSource="ms-appx:///Assets/Welcome/bloom-dark.jpg"
                                Stretch="UniformToFill" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <x:Double x:Key="ContentDialogMaxWidth">640</x:Double>

            <Style x:Key="HeroStyle" TargetType="Border">
                <Setter Property="Height" Value="232" />
                <Setter Property="CornerRadius" Value="{StaticResource OverlayCornerRadius}" />
                <Setter Property="Background" Value="{ThemeResource HeroBackgroundBrush}" />
            </Style>

            <!-- A miniature app card used inside the illustrations -->
            <Style x:Key="MiniCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource SolidBackgroundFillColorTertiaryBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{StaticResource OverlayCornerRadius}" />
                <Setter Property="Padding" Value="14,12" />
            </Style>

            <Style x:Key="SlideTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource SubtitleTextBlockStyle}">
                <Setter Property="Margin" Value="0,24,0,8" />
            </Style>

            <Style x:Key="SlideBodyStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
        </ResourceDictionary>
    </ContentDialog.Resources>

    <StackPanel Width="560" Spacing="16">
        <FlipView x:Name="Slides" Height="404" Background="Transparent" SelectionChanged="Slides_SelectionChanged">

            <!-- 1. Welcome -->
            <FlipViewItem>
                <StackPanel>
                    <Border Style="{StaticResource HeroStyle}">
                        <Image Width="132" Height="132" Source="ms-appx:///Assets/Journal-256.png" />
                    </Border>
                    <TextBlock Style="{StaticResource SlideTitleStyle}" Text="Welcome to Journal" />
                    <TextBlock Style="{StaticResource SlideBodyStyle}"
                               Text="A private place to reflect on your days." />
                </StackPanel>
            </FlipViewItem>

            <!-- 2. Write -->
            <FlipViewItem>
                <StackPanel>
                    <Border Style="{StaticResource HeroStyle}">
                        <Border Width="340" VerticalAlignment="Center" Style="{StaticResource MiniCardStyle}">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="4">
                                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Text="Thu, Oct 30 · 7:42 PM   🙂" />
                                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="A quiet evening walk" />
                                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               MaxLines="2"
                                               Text="The air smelled like rain. I finally called Mom back and we laughed about the old house."
                                               TextTrimming="CharacterEllipsis"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                                <Border Grid.Column="1" Width="64" Height="64"
                                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                                        CornerRadius="{StaticResource ControlCornerRadius}">
                                    <FontIcon FontSize="24" Glyph="&#xEB9F;"
                                              Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                                </Border>
                            </Grid>
                        </Border>
                    </Border>
                    <TextBlock Style="{StaticResource SlideTitleStyle}" Text="Capture your day" />
                    <TextBlock Style="{StaticResource SlideBodyStyle}"
                               Text="Type or dictate your thoughts and add photos. Your entries save automatically as you write." />
                </StackPanel>
            </FlipViewItem>

            <!-- 3. Suggestions -->
            <FlipViewItem>
                <StackPanel>
                    <Border Style="{StaticResource HeroStyle}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal" Spacing="12">
                            <Border Width="170" Height="104" Style="{StaticResource MiniCardStyle}">
                                <StackPanel Spacing="8">
                                    <FontIcon HorizontalAlignment="Left" FontSize="16" Glyph="&#xE82F;"
                                              Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    <TextBlock Text="What made you smile today?" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <Border Width="170" Height="104" Style="{StaticResource MiniCardStyle}">
                                <StackPanel Spacing="8">
                                    <FontIcon HorizontalAlignment="Left" FontSize="16" Glyph="&#xE82F;"
                                              Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    <TextBlock Text="Who are you grateful for right now?" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                    <TextBlock Style="{StaticResource SlideTitleStyle}" Text="Find inspiration" />
                    <TextBlock Style="{StaticResource SlideBodyStyle}"
                               Text="Get writing suggestions when you're stuck, and look back on memories from past years." />
                </StackPanel>
            </FlipViewItem>

            <!-- 4. On-device AI -->
            <FlipViewItem>
                <StackPanel>
                    <Border Style="{StaticResource HeroStyle}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal" Spacing="16">
                            <!-- Format menu -->
                            <Border Width="150" Padding="4" VerticalAlignment="Center" Style="{StaticResource MiniCardStyle}">
                                <StackPanel>
                                    <Grid Padding="10,8" ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon FontSize="14" Glyph="&#xE8D2;" />
                                        <TextBlock Grid.Column="1" Text="Fix errors" />
                                    </Grid>
                                    <Grid Padding="10,8" ColumnSpacing="10"
                                          Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                          CornerRadius="{StaticResource ControlCornerRadius}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon FontSize="14" Glyph="&#xE790;" />
                                        <TextBlock Grid.Column="1" Text="Polish wording" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <!-- Reflection -->
                            <Border Width="230" VerticalAlignment="Center" Style="{StaticResource MiniCardStyle}">
                                <StackPanel Spacing="6">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon FontSize="14" Glyph="&#xE8F2;"
                                                  Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Reflection" />
                                    </StackPanel>
                                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Text="It sounds like calling your mom brought a welcome sense of lightness to your day."
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                    <TextBlock Style="{StaticResource SlideTitleStyle}" Text="Reflect with AI" />
                    <TextBlock Style="{StaticResource SlideBodyStyle}"
                               Text="Tidy your writing, see your mood and topics, and get reflections on your entries. AI runs on this device, so your entries aren't sent to the cloud. AI-generated content may be incorrect." />
                </StackPanel>
            </FlipViewItem>

            <!-- 5. Focus areas -->
            <FlipViewItem>
                <StackPanel>
                    <TextBlock Margin="0,4,0,8" Style="{StaticResource SlideTitleStyle}" Text="What do you want to focus on?" />
                    <TextBlock Margin="0,0,0,20" Style="{StaticResource SlideBodyStyle}"
                               Text="Choose as many as you like. We'll tailor your suggestions and Insights. You can change these anytime in Settings." />
                    <local:FocusPicker />
                </StackPanel>
            </FlipViewItem>

            <!-- 6. Insights and privacy -->
            <FlipViewItem>
                <StackPanel>
                    <Border Style="{StaticResource HeroStyle}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal" Spacing="12">
                            <Border Width="150" Style="{StaticResource MiniCardStyle}">
                                <StackPanel Spacing="2">
                                    <FontIcon HorizontalAlignment="Left" FontSize="18" Glyph="&#xE945;"
                                              Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    <TextBlock Margin="0,6,0,0" Style="{StaticResource SubtitleTextBlockStyle}" Text="7 days" />
                                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               Style="{StaticResource CaptionTextBlockStyle}" Text="Current streak" />
                                </StackPanel>
                            </Border>
                            <Border Width="150" Style="{StaticResource MiniCardStyle}">
                                <StackPanel Spacing="2">
                                    <FontIcon HorizontalAlignment="Left" FontSize="18" Glyph="&#xE72E;"
                                              Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    <TextBlock Margin="0,6,0,0" Style="{StaticResource SubtitleTextBlockStyle}" Text="Locked" />
                                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               Style="{StaticResource CaptionTextBlockStyle}" Text="Windows Hello" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                    <TextBlock Style="{StaticResource SlideTitleStyle}" Text="Your journal stays private" />
                    <TextBlock Style="{StaticResource SlideBodyStyle}"
                               Text="Your entries are encrypted and stored on this device. Add another layer of protection with Windows Hello." />
                    <Grid Margin="0,12,0,0" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon VerticalAlignment="Center" FontSize="16" Glyph="&#xE72E;" />
                        <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="Lock with Windows Hello" />
                        <ToggleSwitch x:Name="HelloToggle"
                                      Grid.Column="2"
                                      MinWidth="0"
                                      AutomationProperties.Name="Lock with Windows Hello"
                                      Toggled="HelloToggle_Toggled" />
                    </Grid>
                    <TextBlock x:Name="HelloMessage"
                               Margin="0,4,0,0"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               TextWrapping="Wrap"
                               Visibility="Collapsed" />
                </StackPanel>
            </FlipViewItem>
        </FlipView>

        <!-- Footer: Back on the left, page dots in the middle, Skip / Next on the right -->
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button x:Name="BackButton" MinWidth="96" Click="Back_Click" Content="Back" />
            <PipsPager x:Name="Pips"
                       Grid.Column="1"
                       VerticalAlignment="Center"
                       MaxVisiblePips="6"
                       SelectedIndexChanged="Pips_SelectedIndexChanged" />
            <StackPanel Grid.Column="2" HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
                <Button x:Name="SkipButton" Click="Skip_Click" Content="Skip" Style="{StaticResource SubtleButtonStyle}" />
                <Button x:Name="NextButton"
                        MinWidth="120"
                        Click="Next_Click"
                        Content="Next"
                        Style="{StaticResource AccentButtonStyle}">
                    <Button.KeyboardAccelerators>
                        <KeyboardAccelerator Key="Right" />
                    </Button.KeyboardAccelerators>
                </Button>
            </StackPanel>
        </Grid>
    </StackPanel>
</ContentDialog>
